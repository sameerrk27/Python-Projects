   "source": [
    "#Simple Calculator\n",
    "a = int(input(\"First Number:\"))\n",
    "b = int(input(\"Second Number:\"))\n",
    "\n",
    "print(\"Add :\",a+b)\n",
    "print(\"Sub :\",a-b)\n",
    "print(\"Mul :\",a*b)\n",
    "print(\"Div :\",a/b)\n",
    "print(\"Floor :\",a//b)\n",
    "print(\"Modulus :\",a%b)"
   ]
